pkgbase = koda-git
	pkgdesc = A modern, lightweight, terminal-native IDE (git checkout)
	pkgver = 0.1.2.r0.g0000000
	pkgrel = 1
	url = https://github.com/etokiyra/koda
	arch = x86_64
	license = MPL-2.0
	makedepends = cargo
	makedepends = git
	depends = glibc
	depends = libgcc
	optdepends = git: git integration
	optdepends = curl: download managed language tools
	optdepends = tar: unpack managed .tar archives
	optdepends = unzip: unpack managed .zip archives
	optdepends = gnupg: verify Swift toolchain signatures
	optdepends = rustup: Rust language server, formatter and asm-lsp fallback
	optdepends = go: fallback for Go-installed language servers
	optdepends = nodejs: fallback for npm-installed language servers
	optdepends = python: Python language server and hashing fallback
	optdepends = clang: C and C++ language server
	optdepends = jdk-openjdk: Java language server runtime
	optdepends = lua-language-server: Lua language server
	optdepends = php: PHP language server runtime
	optdepends = ruby: Ruby language server runtime
	optdepends = perl: Perl language server runtime
	optdepends = dotnet-sdk: C# language server runtime
	optdepends = dart: Dart language server
	optdepends = elixir: Elixir language server runtime
	optdepends = nix: Nix language server and formatter
	provides = koda
	conflicts = koda
	source = git+https://github.com/etokiyra/koda.git
	sha256sums = SKIP

pkgname = koda-git
